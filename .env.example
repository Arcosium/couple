# 앱 인증
ALLOWED_EMAILS=person1@example.com,person2@example.com
SECRET_KEY=replace-with-openssl-rand-hex-32

# 로컬 LLM: OpenAI 호환 API를 제공하는 llama-server/LM Studio 등을 실행한 뒤 설정한다.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=Qwen3.6-35B-A3B-Uncensored-Claude-Genesis-Q8_0.gguf
LOCAL_LLM_TIMEOUT_SECONDS=120

# 선택: 카카오 지도·장소 검색 기능을 사용할 때만 필요하다. LLM 호출에는 사용되지 않는다.
KAKAO_JS_KEY=
KAKAO_REST_KEY=

ANNIVERSARY_DATE=2026-01-01
NICKNAME_A=자기
NICKNAME_B=애기
