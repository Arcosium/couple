# 앱 인증
ALLOWED_EMAILS=person1@example.com,person2@example.com
SECRET_KEY=replace-with-openssl-rand-hex-32

# 로컬 LLM: OpenAI 호환 API를 제공하는 Ollama/llama-server/LM Studio 등을 실행한 뒤 설정한다.
# 이 머신 기본값은 Ollama(11434). 모델 id 는 `curl -s <base_url>/models` 의 data[].id 와 정확히 맞춰야 한다.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen3.6-35b-a3b-uncensored
LOCAL_LLM_TIMEOUT_SECONDS=120

# 선택: 카카오 지도·장소 검색 기능을 사용할 때만 필요하다. LLM 호출에는 사용되지 않는다.
KAKAO_JS_KEY=
KAKAO_REST_KEY=

ANNIVERSARY_DATE=2026-01-01
NICKNAME_A=자기
NICKNAME_B=애기
