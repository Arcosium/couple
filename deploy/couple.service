[Unit]
Description=couple.ai-ve.uk — 2인 전용 커플 앱 (FastAPI)
After=network-online.target
Wants=network-online.target
# 무한 재시작 (사이트가 조용히 죽어 있는 것보다 RestartSec 으로 끊임없이 재시도하는 게 낫다)
StartLimitIntervalSec=0

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/home/opc/projects/couple
# .env 는 app/config.py 가 절대경로로 load_dotenv 하므로 systemd EnvironmentFile 불필요.
# (/home 아래 EnvironmentFile 은 SELinux Enforcing 가 init_t 의 읽기를 막아 Permission denied 로 죽음 — vcnews 와 동일 패턴)
ExecStart=/usr/bin/python3.11 -m uvicorn server:app --host 127.0.0.1 --port 8800 --proxy-headers --forwarded-allow-ips=*
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=couple
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/opc/.local/bin
Environment=PYTHONUNBUFFERED=1
# 인증은 앱 자체(아이디+비밀번호, argon2)가 담당 → Cloudflare Access 없이도 fail-closed.
# CF Access 정책은 해제 가능(터널은 전송용으로 유지). 가입 차단은 ALLOW_SIGNUP=0,
# 두 분이 옛 계정 이어받기(claim) 끝내면 ALLOW_LEGACY_CLAIM=0 으로 닫을 것.
# ⚠️ SECRET_KEY 는 /home/opc/projects/.env 에서 로드 — 강한 무작위값인지 확인(기본값이면 세션 위조 위험).

[Install]
WantedBy=multi-user.target
